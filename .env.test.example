# Test image created from the testenv branch. Pin this to ui-YYYYMMDD-HHMMSS to deploy a specific build.
UI_IMAGE_TAG=ui-test-latest

# Keep test private; Caddy should reverse-proxy to this address.
UI_BIND_ADDRESS=127.0.0.1
UI_PORT=8081

# This API container must be connected to the binops_test_backend Docker network.
API_UPSTREAM=http://binops-sys-api-test:8001
